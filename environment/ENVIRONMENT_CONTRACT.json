{
  "schema_version": 1,
  "production_os": "Ubuntu Linux",
  "python": "3.11.x",
  "pytorch": "2.8.0",
  "torchvision": "0.23.0",
  "cuda_wheel": "cu128",
  "gpu": "NVIDIA RTX 4090 24GB",
  "determinism": {
    "CUBLAS_WORKSPACE_CONFIG": ":4096:8",
    "cudnn_deterministic": true,
    "cudnn_benchmark": false,
    "allow_tf32": false,
    "torch_use_deterministic_algorithms": true
  },
  "compatibility_note": "A different CUDA/PyTorch stack is not assumed byte-identical. All four lanes must use the same captured stack."
}
